# Copy to .env.hosted to run worker commands against the hosted database:
#   yarn workspace @mtg/worker cli:hosted <command>
# Plain `yarn workspace @mtg/worker cli` ignores this file and uses the local Supabase.

# Supabase → Connect → Session pooler (IPv4). Not the transaction pooler: sync jobs use temp tables.
DATABASE_URL=

# The deployed web app and its REVALIDATE_SECRET, so finished syncs and corpus rebuilds refresh cached pages.
WEB_APP_URL=
REVALIDATE_SECRET=

# The search index, written by `cli sync:typesense` and by every finished sync. Unset means the index is not
# updated at all, which is fine locally — the app falls back to Postgres. The admin key is the worker's alone.
TYPESENSE_URL=
TYPESENSE_ADMIN_KEY=

# Where bulk downloads and the deck corpus live (default X:/mtg_proj).
# MTG_DATA_DIR=
