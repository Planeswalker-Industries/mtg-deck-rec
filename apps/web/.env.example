# Copy to .env.local for local development. Values below match the local Supabase stack
# in supabase/config.toml (`supabase start`, then `supabase status -o env`).

# Supabase, read by the browser and the server components. API port 56321.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Salts the visitor hash behind the rate limits. Any string locally; required in production.
RATE_LIMIT_SALT=local-only-not-secret

# Absolute origin for the sitemap, robots file and canonical links. Defaults to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=

# Service-role key (`SECRET_KEY` from supabase status). Only the share-link kill switch needs it.
# SUPABASE_SECRET_KEY=

# Shared with the worker, so a finished sync can refresh cached pages via /api/internal/revalidate.
# REVALIDATE_SECRET=

# The search API (services/search-api), which is the only thing that talks to Typesense. Unset means "no index":
# every read path takes its Postgres query, which is how CI runs.
# Locally: docker compose -f ../../docker-compose.search.yml up -d --build, then
#   yarn workspace @mtg/worker cli sync:typesense --rebuild
# The app only ever gets the read token; the admin token belongs to the worker.
# SEARCH_API_URL=http://localhost:56326
# SEARCH_API_TOKEN=mtg-local-read
# How long a read waits before giving up and using the database instead. Default 2000.
# SEARCH_API_TIMEOUT_MS=

# Runs the deck tool on in-memory mocks instead of the database. CI builds this way.
# NEXT_PUBLIC_USE_MOCKS=1

# Shows the Google button on /sign-in. Off until OAuth credentials exist.
# NEXT_PUBLIC_AUTH_GOOGLE=1

# Where local data lives (bulk downloads, deck corpus, regression fixtures). The default is
# the owner's Windows path, which is not a valid absolute path anywhere else: set it on macOS/Linux.
# MTG_DATA_DIR=
