# Copy to .env beside docker-compose.yml. Never commit the real file.

# Typesense's own key. It never leaves this machine: only search-api holds it, and only search-api can reach
# Typesense at all. The same value goes in deploy/search-api/.env — they are two stacks sharing one secret, so
# changing it means changing it in both places and restarting both.
# Generate one with:  openssl rand -base64 36
TYPESENSE_ADMIN_KEY=

# The shared Docker network, if you created it under another name (`docker network create mtg-search`).
# SEARCH_NETWORK=mtg-search

# How much RAM Typesense may use. It keeps its search index in memory; ours is a few hundred MB, and
# commander_cards is the collection that grows with the corpus.
# TYPESENSE_MEM_LIMIT=1g
