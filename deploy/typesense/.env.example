# Copy to .env beside docker-compose.yml. Never commit the real file.

# The admin key: it can create, drop and write collections. Only the worker and the sync workflow ever hold it.
# The app gets a separate search-only key, made through the API once this is running — see typesense-ops.md.
# Generate one with:  openssl rand -base64 36
TYPESENSE_ADMIN_KEY=

# --- Only for the Traefik variant (docker-compose.traefik.yml) ---
# The hostname Traefik should route to this service. Required by that file; unused by the base one.
# TYPESENSE_HOST=search.example.com
# Traefik's Docker network, its entrypoint and its ACME resolver, if yours are not named these.
# TRAEFIK_NETWORK=traefik
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=letsencrypt

# How much RAM the container may use. Typesense keeps its search index in memory; ours is a few hundred MB, and
# commander_cards is the collection that grows with the corpus.
# TYPESENSE_MEM_LIMIT=1g
