# Copy to .env beside docker-compose.yml. Never commit the real file.
# Generate each token with:  openssl rand -base64 36

# The same value as deploy/typesense/.env. Two stacks, one shared secret: change it in both and restart both.
# It never leaves the VPS — only this service holds it, and only this service can reach Typesense.
TYPESENSE_ADMIN_KEY=

# The web app's token. Reading only — it cannot import documents or drop a collection. This is the one that goes
# on Vercel, where a leak should be able to do as little as possible.
SEARCH_API_TOKEN=

# The worker's token, for `cli sync:typesense` and the daily sync workflow. Reads and writes.
# Must differ from SEARCH_API_TOKEN; the service refuses to start if they match.
SEARCH_API_ADMIN_TOKEN=

# The shared Docker network, if you created it under another name (`docker network create mtg-search`).
# SEARCH_NETWORK=mtg-search

# Which loopback port to publish on, if 8090 is taken.
# SEARCH_API_PORT=8090

# --- Only when Traefik in Docker is the reverse proxy ---
# Leave all of this commented out if nginx or Caddy runs on the host: it reaches this service through the loopback
# port above, and none of these apply.
#
# Traefik cannot use that loopback port. It discovers containers by label and connects to them container to
# container, so it needs both of the first two set — the labels alone do nothing without the shared network.
# TRAEFIK_ENABLE=true
# TRAEFIK_EXTERNAL=true
# The hostname Traefik should route here.
# SEARCH_API_HOST=search.example.com
# Traefik's Docker network, its entrypoint and its ACME resolver, if yours are not named these.
# TRAEFIK_NETWORK=traefik
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=letsencrypt

# Set to a registry tag if you build the image elsewhere rather than on the VPS.
# SEARCH_API_IMAGE=ghcr.io/planeswalker-industries/mtg-search-api:latest
