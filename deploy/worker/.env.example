# Copy to .env beside docker-compose.yml. Never commit the real file.

# Supabase's session pooler connection string (Connect → Session pooler): IPv4, and the jobs need temp tables, so
# never the transaction pooler.
DATABASE_URL=

# The search API's tokens (deploy/search-api/.env). The cron token starts crawls; the admin token lets finished syncs
# update the search index, and starts crawls too when the cron token is left empty.
SEARCH_API_ADMIN_TOKEN=
SEARCH_API_CRON_TOKEN=

# The deployed site and its REVALIDATE_SECRET, so a corpus rebuild refreshes the cached pages.
WEB_APP_URL=
REVALIDATE_SECRET=
